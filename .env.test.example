UMCLICK_TEST_DB_USER=umclick_test
UMCLICK_TEST_DB_PASSWORD=ЗАМЕНИТЕ_ЛОКАЛЬНЫМ_ПАРОЛЕМ
UMCLICK_TEST_DB_NAME=test_umclick_local
