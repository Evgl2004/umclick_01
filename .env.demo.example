POSTGRES_DB=umclick
POSTGRES_USER=umclick
POSTGRES_PASSWORD=change-this-postgres-password

DJANGO_SECRET_KEY=change-this-long-random-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=YOUR_SERVER_IP_OR_DOMAIN
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP_OR_DOMAIN
DJANGO_TIME_ZONE=Asia/Yekaterinburg

FRONTEND_JOIN_BASE=http://YOUR_SERVER_IP_OR_DOMAIN/join

AUTO_REVEAL_BEAT_INTERVAL_SEC=1
CELERY_WORKER_CONCURRENCY=1
HTTP_PORT=80

PRIVACY_POLICY_VERSION=2026-03
PRIVACY_POLICY_URL=http://YOUR_SERVER_IP_OR_DOMAIN/legal/privacy
PERSONAL_DATA_CONSENT_VERSION=2026-03
PERSONAL_DATA_CONSENT_URL=http://YOUR_SERVER_IP_OR_DOMAIN/legal/consent
LEGAL_CONTACT_EMAIL=privacy@umclick.local

TEACHER_SIGNUP_CODE=change-this-demo-teacher-code
